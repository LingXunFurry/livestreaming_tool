{
  "name": "lingxun-tavern-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "desktop": "electron .",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/runtime.mjs start",
    "check": "tsc --noEmit",
    "start": "node scripts/runtime.mjs start",
    "stop": "node scripts/runtime.mjs stop",
    "status": "node scripts/runtime.mjs status",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:migration": "node scripts/verify-migration.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "electron": "^45.2.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
